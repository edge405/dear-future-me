{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-life-journal",
  "account_id": "26e53f6223c9d9fa6950723f4915011c",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["0 11 * * *"] },
  "vars": {
    "AI_ENABLED": "true",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_FREE_TIER_VERIFIED_UNTIL": "2026-12-14"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "life-journal",
    "database_id": "b26d3b99-db7a-4058-b772-4e93af09a40a",
    "migrations_dir": "migrations"
  }]
}
